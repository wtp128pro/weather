#!/usr/bin/env bash
# =============================================================================
# Weather — Code-Signing & Notarization Credentials  (EXAMPLE / TEMPLATE)
# =============================================================================
#
# THIS FILE IS SAFE TO COMMIT.  It is a template only — all values are
# placeholders.
#
# HOW TO USE
#   cp scripts/signing_credentials.sh.example scripts/signing_credentials.sh
#   # Edit signing_credentials.sh and fill in your real values.
#   # signing_credentials.sh is listed in .gitignore and will never be committed.
#
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO OBTAIN EACH VALUE
# ─────────────────────────────────────────────────────────────────────────────
#
# BB_TEAM_ID
#   Your 10-character Apple Developer Team ID.
#   1. Go to https://developer.apple.com/account
#   2. Click "Membership details" in the left sidebar.
#   3. Copy the "Team ID" value (e.g. AQK9MG47BS).
#   Alternative — list it from an already-installed certificate:
#     security find-identity -v | grep "Developer ID Application"
#
# BB_SIGNING_IDENTITY
#   The full codesign identity string for your "Developer ID Application" cert.
#   Format:  "Developer ID Application: <Full Name> (<TEAM_ID>)"
#   List installed identities with:
#     security find-identity -v -p codesigning
#   The cert must be issued by Apple — request it at:
#     https://developer.apple.com/account/resources/certificates/list
#   Choose "Developer ID Application" as the certificate type.
#
# BB_APPLE_ID
#   The email address of your Apple Developer account (Apple ID).
#
# BB_APP_PASSWORD
#   An App-Specific Password used by notarytool.
#   This is NOT your Apple ID login password.
#   1. Go to https://appleid.apple.com
#   2. Sign in → "Sign-In and Security" → "App-Specific Passwords"
#   3. Click "+" and label it something like "Weather notarytool".
#   4. Apple generates a password in the format:  xxxx-xxxx-xxxx-xxxx
#
#   Security tip: instead of storing the password here you can save it in
#   your Keychain and pass --keychain-profile <name> to notarytool:
#     xcrun notarytool store-credentials "Weather" \
#       --apple-id your@email.com \
#       --team-id YOUR_TEAM_ID \
#       --password xxxx-xxxx-xxxx-xxxx
#   Then replace --password / --apple-id / --team-id in build_dmg.sh with:
#     --keychain-profile "Weather"
#
# BB_PROVISIONING_PROFILE
#   Absolute path to a Developer ID provisioning profile (.provisionprofile)
#   bound to the Weather App ID (io.github.wtp128pro.Weather).
#
#   HOW TO CREATE ONE
#     1. developer.apple.com → Certificates, Identifiers & Profiles
#     2. Identifiers → register or select "io.github.wtp128pro.Weather".
#     3. Profiles → "+" → Distribution → "Developer ID" → select the App ID above
#        → select your Developer ID Application certificate → Download.
#     4. Save to macos/provisioning/Weather_Provisioning.provisionprofile
#        (or set BB_PROVISIONING_PROFILE to the downloaded path).
#
# =============================================================================

export BB_TEAM_ID="YOUR_TEAM_ID"
export BB_SIGNING_IDENTITY="Developer ID Application: Your Name (YOUR_TEAM_ID)"
export BB_APPLE_ID="your@apple-developer-email.com"
export BB_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# Optional override — defaults to macos/provisioning/Weather_Provisioning.provisionprofile
# export BB_PROVISIONING_PROFILE="/absolute/path/to/your.provisionprofile"
