[weather]
name=Weather for Fedora $releasever - $basearch
baseurl=https://wtp128pro.github.io/weather/fedora/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://wtp128pro.github.io/weather/RPM-GPG-KEY-weather

[weather-source]
name=Weather for Fedora $releasever - Source
baseurl=https://wtp128pro.github.io/weather/fedora/$releasever/SRPMS/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://wtp128pro.github.io/weather/RPM-GPG-KEY-weather
